# ==============================================================================
# EVA Bharat - Multi-Window Media Sequencer
# Environment Configuration Template
# ==============================================================================

# HTTP Server Port
PORT=8080

# Environment Mode: development | staging | production | test
ENVIRONMENT=development

# Persistent PostgreSQL Connection URL
# The included Compose database is published on 5434 to avoid colliding with
# an existing local PostgreSQL installation.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/eva_media?sslmode=disable

# CORS Allowed Origins (comma-separated for multiple origins)
# In production, set this to the exact deployed Netlify origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
